---
import BaseLayout from '../layouts/BaseLayout.astro'
import ArticleCard from '../components/ArticleCard.astro'
import { getCollection } from 'astro:content'

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const featured = articles[0]
const rest = articles.slice(1, 6)
---

<BaseLayout>
  <section class="pb-12 border-b border-border">
    <p class="font-sans text-sm text-ink-muted uppercase tracking-widest">Remoratechnical</p>
    <h1 class="mt-3 font-sans text-4xl md:text-5xl font-bold tracking-tight leading-tight">
      Strength coaching, written down.
    </h1>
    <p class="mt-5 text-xl text-ink-muted leading-snug max-w-prose">
      Programming notes, technique cues, and the thinking behind the choices I make
      with the lifters I coach. Plus the training tool I built to make it all easier.
    </p>
    <div class="mt-6 flex flex-wrap gap-4 font-sans text-sm">
      <a href="/articles" class="no-underline hover:underline">Read the articles →</a>
      <a href="/powertrack" class="no-underline hover:underline">Try PowerTrack →</a>
      <a href="/coaching" class="no-underline hover:underline text-ink-muted hover:text-ink">Work with me →</a>
    </div>
  </section>

  {featured && (
    <section class="pt-10">
      <h2 class="font-sans text-sm uppercase tracking-widest text-ink-muted mb-2">Latest</h2>
      <ArticleCard entry={featured} />
    </section>
  )}

  {rest.length > 0 && (
    <section class="pt-6">
      <h2 class="font-sans text-sm uppercase tracking-widest text-ink-muted mb-2">More</h2>
      {rest.map((entry) => <ArticleCard entry={entry} />)}
      <p class="mt-6 font-sans text-sm">
        <a href="/articles" class="no-underline hover:underline">All articles →</a>
      </p>
    </section>
  )}

  {articles.length === 0 && (
    <section class="pt-10 text-ink-muted">
      <p>Articles coming soon.</p>
    </section>
  )}
</BaseLayout>
