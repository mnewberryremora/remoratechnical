---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ArticleCard from '../../components/ArticleCard.astro'
import { getCollection } from 'astro:content'

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
---

<BaseLayout title="Articles" description="Everything written on the site, newest first.">
  <header class="pb-6 border-b border-border mb-4">
    <h1 class="font-sans text-4xl font-bold tracking-tight">Articles</h1>
    <p class="mt-2 text-ink-muted">Newest first.</p>
  </header>

  {articles.length === 0 ? (
    <p class="text-ink-muted mt-6">No articles yet.</p>
  ) : (
    <div>
      {articles.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  )}
</BaseLayout>
