---
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'articles'>
}

const { entry } = Astro.props
const d = entry.data.pubDate
const dateLabel = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
---

<article class="border-b border-border py-6 last:border-b-0">
  <a href={`/articles/${entry.slug}`} class="no-underline block group">
    <h2 class="font-sans text-2xl font-bold text-ink group-hover:text-accent transition-colors">
      {entry.data.title}
    </h2>
    <p class="mt-2 text-ink-muted">{entry.data.description}</p>
    <p class="mt-3 text-sm font-sans text-ink-muted">
      {dateLabel}
      {entry.data.tags && entry.data.tags.length > 0 && (
        <>
          <span class="mx-2">·</span>
          {entry.data.tags.join(' · ')}
        </>
      )}
    </p>
  </a>
</article>
