---
import BaseLayout from './BaseLayout.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'articles'>
}

const { entry } = Astro.props
const d = entry.data.pubDate
const dateLabel = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article>
    <header class="mb-8">
      <p class="font-sans text-sm text-ink-muted uppercase tracking-wider">
        {dateLabel}
        {entry.data.tags && entry.data.tags.length > 0 && (
          <>
            <span class="mx-2">·</span>
            {entry.data.tags.join(' · ')}
          </>
        )}
      </p>
      <h1 class="mt-3 font-sans text-4xl md:text-5xl font-bold tracking-tight leading-tight">
        {entry.data.title}
      </h1>
      {entry.data.description && (
        <p class="mt-4 text-xl text-ink-muted leading-snug">{entry.data.description}</p>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  <nav class="mt-16 pt-8 border-t border-border">
    <a href="/articles" class="font-sans text-sm no-underline hover:underline">← All articles</a>
  </nav>
</BaseLayout>
